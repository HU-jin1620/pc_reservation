[Unit]
Description=Shenzhen PC Booking System
After=network.target

[Service]
Type=simple
User=jimmy.xie
WorkingDirectory=/home/jimmy.xie/PC_reserved
Environment=HOST=0.0.0.0
Environment=PORT=5000
ExecStart=/home/jimmy.xie/PC_reserved/venv/bin/python app.py
Restart=on-failure
StandardOutput=append:/home/jimmy.xie/PC_reserved/booking.log
StandardError=append:/home/jimmy.xie/PC_reserved/booking.log

[Install]
WantedBy=multi-user.target

